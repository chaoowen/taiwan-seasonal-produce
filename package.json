{
  "name": "my-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "hozu dev",
    "check": "hozu check",
    "start": "hozu serve",
    "build": "hozu build",
    "snapshot:prices": "node scripts/price-snapshot.ts",
    "build:worker": "node scripts/subset-fonts.ts && node scripts/price-snapshot.ts && node scripts/make-share-image.ts && hozu build && node scripts/build-worker.ts",
    "preview:worker": "npm run build:worker && wrangler dev",
    "deploy": "npm run build:worker && wrangler deploy",
    "fonts": "node scripts/subset-fonts.ts",
    "sync:catalog": "node scripts/sync-catalog.ts",
    "photos": "node scripts/fetch-photos.ts",
    "share-image": "node scripts/make-share-image.ts"
  },
  "dependencies": {
    "@hozu/adapter-node": "^0.17.1",
    "@hozu/bundle": "^0.17.1",
    "@hozu/cli": "^0.17.1",
    "@hozu/core": "^0.17.1",
    "@hozu/css": "^0.17.1",
    "@hozu/data": "^0.17.1",
    "@hozu/runtime-server": "^0.17.1",
    "@hozu/schema-zod": "^0.17.1",
    "@hozu/transform": "^0.17.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@hozu/dev": "^0.17.1",
    "@hozu/testing": "^0.17.1",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
